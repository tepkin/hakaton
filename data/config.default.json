{
  "project": {"name": "Пилотный объект", "territory_type": "T1"},
  "run": {"seed": 42, "range_policy": "max"},
  "gen": {"tree_spacing": 5.0, "shrub_spacing": 1.5, "tree_shrub_min": 2.0,
          "max_trees": 60, "max_shrubs": 80, "road_near_m": 8.0},
  "budget": {"mode": "tsn_norm", "manual_value_mln": 20.0, "manual_unit": "mln_total", "policy": "warn"},
  "layers": {"trees": "GREEN_AI_TREES", "shrubs": "GREEN_AI_SHRUBS",
