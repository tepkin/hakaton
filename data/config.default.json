  "export": {"tree_radius": 3.0, "shrub_radius": 1.0, "text_height": 1.0},
  "layer_patterns": {
    "boundary": ["граница", "boundary", "border"],
    "buildings": ["здание", "строени", "building", "build"],
    "roads": ["проезж", "трамвай", "дорожн", "road", "street", "улиц"],
    "sidewalks": ["тротуар", "пешеход", "sidewalk"],
    "water_pipe": ["люк", "водопровод", "канализ", "теплосет", "инженерн", "water", "sewage", "heat"],
    "gas": ["газопровод", "газ", "gas"],
    "cable": ["кабел", "связ", "cable"],
    "power_line": ["лэп", "воздушн", "power", "electr"],
    "existing_trees": ["дерево", "насажд", "дендро", "tree"],
    "existing_shrubs": ["кустар", "shrub"]
  },
  "layer_mapper": {"auto_threshold": 0.55, "profile": "default"},
  "dwg": {"enabled": true, "converter_path": "", "cache_dir": "out/dwg_cache"}
}